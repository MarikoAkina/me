{
  "name": "sql-lab",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "npm run test:acceptance && npm run test:desktop && npm run test:updates",
    "test:acceptance": "node tests/engine.test.mjs && node --test tests/expansion.test.mjs && node tests/storage.test.mjs && node tests/ui.test.mjs && npm run test:lessons",
    "test:lessons": "node --test tests/lessons.test.mjs tests/mobile-viewport.test.mjs",
    "test:engine": "node tests/engine.test.mjs && node --test tests/expansion.test.mjs",
    "test:storage": "node tests/storage.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "desktop:prepare": "npm run build && npm ci --prefix desktop && node desktop/prepare.mjs",
    "desktop": "npm run desktop:prepare && electron desktop",
    "dist:windows": "npm run desktop:prepare && electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "test:updates": "node --test tests/updates.test.mjs tests/updater.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "node-sql-parser": "^5.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "type": "module",
  "license": "MIT",
  "description": "A mobile-friendly MySQL basics learning simulator with local databases and guided exercises.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarikoAkina/sql-lab.git"
  },
  "bugs": {
    "url": "https://github.com/MarikoAkina/sql-lab/issues"
  }
}
